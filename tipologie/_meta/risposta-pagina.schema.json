{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dbenigmistica:tipologie:meta:risposta-pagina:1",
  "title": "Risposta del Fornitore AI per una pagina (involucro generico)",
  "description": "Forma comune a ogni risposta di estrazione. Lo schema inviato al Fornitore AI è derivato dai descrittori e restringe 'dati' e 'confidenza' per ogni Tipologia (progetto-1.1.md, sezione 3.2). Le definizioni 'riquadro' e 'griglia' devono restare identiche a quelle di risultato-atteso.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["versione_formato", "contenuto_pagina", "rivista", "giochi", "avvisi"],
  "properties": {
    "versione_formato": { "const": 1 },
    "contenuto_pagina": { "$ref": "#/$defs/contenutoPagina" },
    "rivista": {
      "description": "Metadati della Rivista se la pagina li mostra (di solito la copertina), altrimenti null.",
      "anyOf": [ { "type": "null" }, { "$ref": "#/$defs/metadatiRivista" } ]
    },
    "giochi": {
      "type": "array",
      "maxItems": 50,
      "items": { "anyOf": [ { "$ref": "#/$defs/giocoNoto" }, { "$ref": "#/$defs/giocoProposto" } ] }
    },
    "avvisi": { "$ref": "#/$defs/avvisi" }
  },
  "$defs": {
    "contenutoPagina": {
      "type": "string",
      "enum": ["giochi", "soluzioni", "copertina", "indice", "pubblicita", "altro"]
    },
    "idTipologia": {
      "type": "string",
      "maxLength": 30,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "famiglia": {
      "type": "string",
      "enum": ["cruciverba", "gioco-breve", "crittografia", "rebus", "logico"]
    },
    "testoONull": {
      "anyOf": [ { "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 200 } ]
    },
    "metadatiRivista": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testata", "numero", "anno", "data_pubblicazione", "periodicita"],
      "properties": {
        "testata": { "$ref": "#/$defs/testoONull" },
        "numero": { "anyOf": [ { "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 50 } ] },
        "anno": { "anyOf": [ { "type": "null" }, { "type": "integer", "minimum": 1900, "maximum": 2100 } ] },
        "data_pubblicazione": {
          "anyOf": [ { "type": "null" }, { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" } ]
        },
        "periodicita": {
          "anyOf": [ { "type": "null" }, { "type": "string", "enum": ["settimanale", "quindicinale", "mensile", "bimestrale", "trimestrale", "altra"] } ]
        }
      }
    },
    "riquadro": {
      "description": "Riquadro normalizzato: origine in alto a sinistra, valori tra 0 e 1 rispetto a larghezza e altezza della pagina.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "larghezza", "altezza"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "larghezza": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "altezza": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "griglia": {
      "description": "Valore del tipo 'griglia'. Una stringa per riga: '#' casella nera, '.' casella bianca vuota, 'A'-'Z' lettera stampata, '?' casella illeggibile. Numeri con riga e colonna da 1.",
      "type": "object",
      "additionalProperties": false,
      "required": ["righe", "colonne", "celle", "numeri"],
      "properties": {
        "righe": { "type": "integer", "minimum": 1, "maximum": 60 },
        "colonne": { "type": "integer", "minimum": 1, "maximum": 60 },
        "celle": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "items": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[#.?A-Z]+$" }
        },
        "numeri": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["riga", "colonna", "numero"],
            "properties": {
              "riga": { "type": "integer", "minimum": 1, "maximum": 60 },
              "colonna": { "type": "integer", "minimum": 1, "maximum": 60 },
              "numero": { "type": "integer", "minimum": 1, "maximum": 999 }
            }
          }
        }
      }
    },
    "probabilita": { "type": "number", "minimum": 0, "maximum": 1 },
    "avvisi": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "giocoNoto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stato_tipologia", "tipologia", "versione_tipologia", "titolo", "riquadro", "dati", "confidenza", "avvisi"],
      "properties": {
        "stato_tipologia": { "const": "nota" },
        "tipologia": { "$ref": "#/$defs/idTipologia" },
        "versione_tipologia": { "type": "integer", "minimum": 1, "maximum": 999 },
        "titolo": { "$ref": "#/$defs/testoONull" },
        "riquadro": { "$ref": "#/$defs/riquadro" },
        "dati": {
          "description": "Valori dei campi e degli elenchi del descrittore. Lo schema derivato li fissa per Tipologia.",
          "type": "object"
        },
        "confidenza": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gioco", "tipologia", "campi", "elenchi"],
          "properties": {
            "gioco": { "$ref": "#/$defs/probabilita" },
            "tipologia": { "$ref": "#/$defs/probabilita" },
            "campi": { "type": "object", "additionalProperties": { "$ref": "#/$defs/probabilita" } },
            "elenchi": { "type": "object", "additionalProperties": { "$ref": "#/$defs/probabilita" } }
          }
        },
        "avvisi": { "$ref": "#/$defs/avvisi" }
      }
    },
    "giocoProposto": {
      "description": "Gioco di una Tipologia non presente nel catalogo: si salva come nuova tipologia proposta (criterio 7).",
      "type": "object",
      "additionalProperties": false,
      "required": ["stato_tipologia", "tipologia_proposta", "titolo", "riquadro", "trascrizione", "confidenza", "avvisi"],
      "properties": {
        "stato_tipologia": { "const": "proposta" },
        "tipologia_proposta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nome", "famiglia", "descrizione"],
          "properties": {
            "nome": { "type": "string", "minLength": 1, "maxLength": 80 },
            "famiglia": { "anyOf": [ { "type": "null" }, { "$ref": "#/$defs/famiglia" } ] },
            "descrizione": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "titolo": { "$ref": "#/$defs/testoONull" },
        "riquadro": { "$ref": "#/$defs/riquadro" },
        "trascrizione": {
          "description": "Testo visibile del Gioco, riga per riga, senza risolverlo.",
          "anyOf": [ { "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 8000 } ]
        },
        "confidenza": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gioco", "tipologia"],
          "properties": {
            "gioco": { "$ref": "#/$defs/probabilita" },
            "tipologia": { "$ref": "#/$defs/probabilita" }
          }
        },
        "avvisi": { "$ref": "#/$defs/avvisi" }
      }
    }
  }
}

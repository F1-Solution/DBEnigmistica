root = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# CTJ001 (Corvus) chiede letterali UTF-8 anche per System.Text.Json: si tace solo nei file che lo usano.
[{src/DBEnigmistica.AI/Services/ClaudeCodeUscita.cs,tests/DBEnigmistica.Tests/Unit/FornitoreAi/DecoratoriFornitoreAiTests.cs,tests/DBEnigmistica.Tests/Unit/Services/DataExportServiceTests.cs}]
dotnet_diagnostic.CTJ001.severity = none
